# Athena API keys. Copy this file to `.env` and fill in the values by hand.
#   .env is gitignored and a Claude Code hook stops the assistant from reading or editing it.
#   Leave a key blank to disable the feature that needs it. Nothing here is needed to run the
#   offline test suite. When this file gains a new key, copy the new line into `.env` yourself.
#
# Needed by: P1b = Phase 1b (LLM provider), P1 = Phase 1 (stocks), P5 = Phase 5 (live/paper brokers).
# Every market-data source used so far (jugaad-data, nsepython, yfinance, mftool, niftyindices,
# NSE/AMFI files) needs NO key.

# ---------------------------------------------------------------------------------------------
# LLM provider (the specialists and the judge run on it). Needed by: P1b
# ---------------------------------------------------------------------------------------------
# NVIDIA API catalog (NIM): https://build.nvidia.com  (primary provider; free developer credits,
# OpenAI-compatible endpoint https://integrate.api.nvidia.com/v1, key starts with nvapi-)
NVIDIA_API_KEY=

# OpenRouter: https://openrouter.ai/keys  (fallback; the default tiers use its free models, which have a
# daily request cap on free-tier accounts. Change the models in TIERS in src/athena/llm/router.py)
OPENROUTER_API_KEY=

# OpenAI: https://platform.openai.com/api-keys  (fallback and second runtime; the default tiers use its
# cheap nano/mini models. The code sets no spend limit, so the account balance is the only one: keep
# auto-recharge off)
OPENAI_API_KEY=

# TypeSafe / Jev: https://typesafe.com  (optional: the same key the `jev` CLI uses; model lane router
# and optional resolver classifier)
TYPESAFE_API_KEY=

# ---------------------------------------------------------------------------------------------
# Macro and research data. Needed by: P1 (optional)
# ---------------------------------------------------------------------------------------------
# FRED: https://fred.stlouisfed.org/docs/api/api_key.html  (free; global macro series. India's risk-free
# rate does not use it, the Nifty 1D Rate Index needs no key)
FRED_API_KEY=

# Hugging Face: https://huggingface.co/settings/tokens  (optional, not needed yet: a fine-grained or
# "Read" token is enough, and only for faster downloads of the public Kronos forecasting weights)
HF_TOKEN=

# ---------------------------------------------------------------------------------------------
# Brokers. Fill in only the broker you trade with (or none: paper trading needs no account).
# Athena works with Groww, Zerodha, Angel One, ICICI Direct and Upstox; see docs/brokers/README.md.
# The tokens below expire every day, so each is a morning step. Anyone who can read this file can
# trade your account: keep it private.
# ---------------------------------------------------------------------------------------------
# Groww Trade API: https://groww.in/trade-api  (token expires daily at 6 AM)
GROWW_ACCESS_TOKEN=

# Zerodha Kite Connect: https://developers.kite.trade/apps
# Free Personal plan = orders, GTT and portfolio only. Live WebSocket data and historical candles need
# the paid Connect plan (Rs 500 per month per API key). The access token comes from
# python -m athena.brokers.kite_login --listen
KITE_API_KEY=
KITE_API_SECRET=
KITE_ACCESS_TOKEN=

# ICICI Direct (Breeze API): https://api.icicidirect.com/apiuser/home  (session token daily; orders
# must come from the static IP registered with ICICI)
ICICI_APP_KEY=
ICICI_SECRET_KEY=
ICICI_SESSION_TOKEN=

# Upstox: https://upstox.com/developer/apps  (access token daily; the key, secret and redirect address
# are only for the daily login)
UPSTOX_ACCESS_TOKEN=
UPSTOX_API_KEY=
UPSTOX_API_SECRET=
UPSTOX_REDIRECT_URI=

# ---------------------------------------------------------------------------------------------
# Angel One SmartAPI: the live market data stream for the terminal's price panel, and (if Angel One is your broker) orders.
# Create the app at https://smartapi.angelone.in (My Apps) and enable TOTP on the same site.
# ANGEL_TOTP_SECRET is the text key shown beside the TOTP QR code, not the 6-digit code.
# Anyone who can read these four lines can log in to the account: keep this file private.
# ---------------------------------------------------------------------------------------------
ANGEL_API_KEY=
ANGEL_CLIENT_CODE=
ANGEL_PIN=
ANGEL_TOTP_SECRET=

# ---------------------------------------------------------------------------------------------
# Reddit (optional, read-only, for the Sentiment page): register a "script" app at https://www.reddit.com/prefs/apps
# REDDIT_USER_AGENT is a short description of you and the app, for example: athena-owner-research by u/yourname
# ---------------------------------------------------------------------------------------------
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=
