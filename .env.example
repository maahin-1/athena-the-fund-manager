# Athena API keys. Copy this file to `.env` and fill in the values by hand.
#   .env is gitignored and a Claude Code hook stops the assistant from reading or editing it.
#   Leave a key blank to disable the feature that needs it. Nothing here is needed to run the
#   offline test suite. When this file gains a new key, copy the new line into `.env` yourself.
#
# Needed by: P1b = Phase 1b (LLM provider), P1 = Phase 1 (stocks), P5 = Phase 5 (live/paper brokers).
# Every market-data source used so far (jugaad-data, nsepython, yfinance, mftool, niftyindices,
# NSE/AMFI files) needs NO key.

# ---------------------------------------------------------------------------------------------
# LLM provider (the specialists and the judge run on it). Needed by: P1b
# ---------------------------------------------------------------------------------------------
# NVIDIA API catalog (NIM): https://build.nvidia.com  (the only LLM provider; free developer credits,
# OpenAI-compatible endpoint https://integrate.api.nvidia.com/v1, key starts with nvapi-)
NVIDIA_API_KEY=

# TypeSafe / Jev: https://typesafe.com  (optional: the same key the `jev` CLI uses; model lane router
# and optional resolver classifier)
TYPESAFE_API_KEY=

# ---------------------------------------------------------------------------------------------
# Macro and research data. Needed by: P1 (optional)
# ---------------------------------------------------------------------------------------------
# FRED: https://fred.stlouisfed.org/docs/api/api_key.html  (free; global macro series. India's risk-free
# rate does not use it, the Nifty 1D Rate Index needs no key)
FRED_API_KEY=

# Hugging Face: https://huggingface.co/settings/tokens  (optional, not needed yet: a fine-grained or
# "Read" token is enough, and only for faster downloads of the public Kronos forecasting weights)
HF_TOKEN=

# ---------------------------------------------------------------------------------------------
# Zerodha is the only broker. Needed by: P5, and by the live-feed adapter if you build it earlier.
# The access token expires every day and is refreshed by the login flow, so leave it blank until the
# adapter exists.
# ---------------------------------------------------------------------------------------------
# Zerodha Kite Connect: https://developers.kite.trade/apps
# Free Personal plan = orders, GTT and portfolio only. Live WebSocket data and historical candles need
# the paid Connect plan (Rs 500 per month per API key).
KITE_API_KEY=
KITE_API_SECRET=
KITE_ACCESS_TOKEN=
